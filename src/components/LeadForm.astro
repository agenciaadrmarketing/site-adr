---
interface Props {
  origem: string;
  title?: string;
  text?: string;
  buttonLabel?: string;
  class?: string;
  compact?: boolean;
}
const {
  origem,
  title = 'Solicite um diagnóstico da agenda',
  text = 'Resposta pelo WhatsApp em horário comercial.',
  buttonLabel = 'Solicite um diagnóstico da agenda',
  class: cls = '',
  compact = false,
} = Astro.props;
const uid = `lf-${origem.replace(/[^a-z0-9]/gi, '')}`;
---

<div class:list={['lead', cls]} data-lead>
  <form class="lead__form" data-lead-form data-origem={origem} novalidate aria-labelledby={`${uid}-titulo`}>
    {!compact && (
      <>
        <h3 class="lead__title" id={`${uid}-titulo`}>{title}</h3>
        <p class="lead__text">{text}</p>
      </>
    )}
    {compact && <h3 class="sr-only" id={`${uid}-titulo`}>{title}</h3>}
    <div class="form">
      <label class="field"><span class="field__label">Nome completo</span><input class="input" name="nome" type="text" required autocomplete="name" placeholder="Dr. / Dra." maxlength="120" /></label>
      <label class="field"><span class="field__label">Email (opcional)</span><input class="input" name="email" type="email" autocomplete="email" placeholder="Seu melhor email" maxlength="160" /></label>
      <label class="field"><span class="field__label">WhatsApp</span><input class="input" name="fone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(00) 00000-0000" maxlength="20" /></label>
      <div class="form__row">
        <label class="field"><span class="field__label">Especialidade</span>
          <select class="input" name="area" required>
            <option value="">Selecione</option>
            <option>Clínica médica</option>
            <option>Consultório médico</option>
            <option>Outra área da saúde</option>
          </select>
        </label>
        <label class="field"><span class="field__label">Pacientes/mês</span>
          <select class="input" name="fat" required>
            <option value="">Selecione</option>
            <option>Até 20 pacientes</option>
            <option>20 a 50 pacientes</option>
            <option>50 a 120 pacientes</option>
            <option>Acima de 120 pacientes</option>
          </select>
        </label>
      </div>
      <label class="hp" aria-hidden="true">Site<input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
      <p class="form__status" data-lead-status aria-live="polite"></p>
      <button class="btn btn--light btn--block" type="submit">
        {buttonLabel}
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </button>
    </div>
    <p class="form__note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
      Seus dados estão seguros e seguem a <a href="/politica-de-privacidade/">política de privacidade</a>.
    </p>
  </form>

  <div class="lead__ok" data-lead-success hidden>
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
    <h3 class="lead__title" tabindex="-1">Recebemos seus dados</h3>
    <p class="lead__text">Vamos continuar por WhatsApp. Se a janela não abriu, toque no botão abaixo.</p>
    <a class="btn btn--wa brilho" href="#" target="_blank" rel="noopener" data-lead-wa>
      <span class="brilho__aro" aria-hidden="true"><i></i></span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg>
      Abrir o WhatsApp
    </a>
  </div>
</div>

<style>
  .lead { width: 100%; max-width: 430px; min-width: 0; border: 1px solid rgba(242, 242, 243, 0.2); background: rgba(15, 15, 14, 0.9); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); }
  .lead--wide { max-width: none; }
  .lead__title { font-weight: 600; font-size: clamp(18px, 1.5vw, 21px); margin: 0 0 5px; color: var(--ink); }
  .lead__text { margin: 0 0 clamp(16px, 1.8vw, 20px); font-size: 13px; color: var(--n-500); line-height: 1.55; }
  .lead__ok { text-align: center; }
  .lead__ok svg:first-child { margin: 0 auto 16px; color: var(--n-300); }
  .lead__ok .lead__text { margin-bottom: 18px; }
  .form__note a { color: var(--n-400); text-decoration: underline; text-underline-offset: 2px; }
  .form__note a:hover { color: var(--ink); }
</style>
