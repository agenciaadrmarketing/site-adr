---
interface Props {
  href?: string;
  variant?: 'light' | 'dark' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  arrow?: boolean;
  openModal?: string;
  onLight?: boolean;
  [key: string]: unknown;
}

const { href, variant = 'light', size = 'md', type = 'button', class: cls = '', arrow = false, openModal, onLight = false, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, { 'btn--sm': size === 'sm', 'btn--lg': size === 'lg', 'glow-fino': variant === 'outline', 'on-light': onLight }, cls];
---

{
  href ? (
    <a class:list={classes} href={href} {...rest}>
      <slot />
      {arrow && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>}
    </a>
  ) : (
    <button class:list={classes} type={type} data-open-modal={openModal} {...rest}>
      <slot />
      {arrow && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>}
    </button>
  )
}
