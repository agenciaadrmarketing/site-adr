---
import type { Service } from '../data/site';

interface Props {
  service: Pick<Service, 'title' | 'description' | 'icon'> & { href?: string };
  num?: string;
  tall?: boolean;
  large?: boolean;
}
const { service, num, tall = false, large = false } = Astro.props;

const ICONS: Record<string, string> = {
  chart: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  shield: '<path d="M12 2 4 6v6c0 5 3.4 9.2 8 10 4.6-.8 8-5 8-10V6l-8-4Z"/><path d="m9 12 2 2 4-4"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  bars: '<path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  badge: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/>',
};
const Tag = service.href ? 'a' : 'article';
---

<Tag class:list={['card', 'service', { 'service--tall': tall, 'service--large': large }]} href={service.href} data-reveal>
  <div class="card__top">
    <span class="card__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[service.icon] || ICONS.check} />
    </span>
    {num && <span class="card__num">{num}</span>}
  </div>
  <h3 class="card__title">{service.title}</h3>
  <p class="card__text">{service.description}</p>
  {service.href && <span class="service__more">Ver detalhes <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></span>}
</Tag>

<style>
  .service { color: var(--ink); }
  .service--tall { grid-row: span 2; }
  .service--large .card__title { font-size: clamp(19px, 1.7vw, 25px); }
  .service--large .card__text { font-size: 14.5px; }
  .service__more { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--n-400); }
  a.service:hover .service__more { color: var(--ink); }
</style>
