---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Button from './Button.astro';
import SectionLabel from './SectionLabel.astro';
import Faq from './Faq.astro';
import LeadForm from './LeadForm.astro';
import RelatedLinks from './RelatedLinks.astro';
import { SITE, SPECIALTIES, whatsappUrl } from '../data/site';
import { webPage, breadcrumbList, faqPage } from '../data/seo';

interface Props {
  data: {
    slug: string;
    nome: string;
    plural: string;
    title: string;
    description: string;
    h1: string;
    h1Accent: string;
    resposta: string;
    wa: string;
    jornada: { titulo: string; texto: string; pontos: string[] };
    demanda: { google: string; meta: string; conteudo: string };
    frentes: { t: string; d: string }[];
    sensiveis: string[];
    faq: { q: string; a: string }[];
    relacionadas: string[];
  };
}
const { data: d } = Astro.props;
const path = `/${d.slug}/`;
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Marketing médico', href: '/marketing-medico/' }, { label: d.nome, href: path }];
const faq = d.faq.map((f) => ({ ...f, tag: d.nome }));
const service = {
  '@type': 'Service',
  '@id': `${SITE.url}${path}#service`,
  name: `Marketing médico para ${d.plural}`,
  serviceType: 'Marketing médico',
  description: d.description,
  provider: { '@id': `${SITE.url}/#org` },
  areaServed: 'BR',
  audience: { '@type': 'Audience', audienceType: `${d.nome}: médicos e clínicas` },
  url: `${SITE.url}${path}`,
};
const jsonLd = [webPage({ path, title: d.title, description: d.description }), breadcrumbList(crumbs), faqPage(faq, path), service];
const related = d.relacionadas
  .map((slug) => SPECIALTIES.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => !!s && s.status === 'publicada')
  .map((s) => ({ label: `Marketing para ${s.plural.toLowerCase()}`, href: `/${s.slug}/`, text: `Jornada, demanda e pontos sensíveis em ${s.name.toLowerCase()}.` }));
---

<BaseLayout title={d.title} description={d.description} jsonLd={jsonLd} waMessage={d.wa} cta={{ title: `Vamos estruturar a captação em ${d.nome.toLowerCase()}?`, text: 'A viabilidade de novas parcerias é sempre condicionada a um diagnóstico comercial prévio — e o modelo admite poucos parceiros simultâneos.', waMessage: d.wa, id: `cta-${d.slug}` }}>
  <PageHero kicker={`Especialidade · ${d.nome}`} title={d.h1} titleAccent={d.h1Accent} text={d.resposta} crumbs={crumbs} variant="specialty">
    <WhatsAppButton id={`${d.slug}-hero`} label="Solicitar diagnóstico pelo WhatsApp" message={d.wa} arrow />
    <Button variant="outline" openModal={`${d.slug}-hero`}>Pedir análise gratuita</Button>
  </PageHero>

  <section class="section" aria-labelledby="jor-title">
    <div class="container split">
      <div class="col" data-reveal>
        <SectionLabel n="01" label="Jornada do paciente" />
        <h2 class="h2" id="jor-title">{d.jornada.titulo}</h2>
        <p class="lead">{d.jornada.texto}</p>
      </div>
      <ul class="checks col col--list" data-reveal>
        {d.jornada.pontos.map((p) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="dem-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="02" label="Onde está a demanda" />
          <h2 class="h2" id="dem-title">Google Ads e Meta Ads <span class="graphite">em {d.nome.toLowerCase()}</span></h2>
        </div>
        <p class="lead head-row__text">{d.demanda.conteudo} Veja a <a href="/marketing-medico/">comparação geral entre os canais</a> no guia de marketing médico.</p>
      </div>
      <div class="canais">
        <article class="card card--white card--static" data-reveal>
          <span class="card__num">Google Ads</span>
          <h3 class="h3">Captura quem já procura</h3>
          <p class="card__text">{d.demanda.google}</p>
        </article>
        <article class="card card--white card--static" data-reveal>
          <span class="card__num">Meta Ads</span>
          <h3 class="h3">Constrói confiança antes da busca</h3>
          <p class="card__text">{d.demanda.meta}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fre-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="03" label="O que a ADR faz" />
          <h2 class="h2" id="fre-title">As quatro frentes aplicadas a <span class="silver">{d.plural}</span></h2>
        </div>
        <p class="lead head-row__text">As mesmas frentes dos <a href="/servicos/">serviços da ADR</a>, ajustadas à jornada desta especialidade. Sempre integradas: nenhuma funciona isolada.</p>
      </div>
      <div class="grid-cards">
        {d.frentes.map((f, i) => (
          <article class="card card--static" data-reveal>
            <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__title" style="margin-top:14px">{f.t}</h3>
            <p class="card__text">{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="sen-title">
    <div class="container split">
      <div class="col" data-reveal>
        <SectionLabel n="04" label="Publicidade médica" />
        <h2 class="h2" id="sen-title">Pontos sensíveis em <span class="graphite">{d.nome.toLowerCase()}</span></h2>
        <p class="lead">A Resolução CFM nº 2.336/2023 define o que a publicidade médica permite e veda; as plataformas de anúncio têm políticas próprias para temas de saúde. Nesta especialidade, os cuidados abaixo são inegociáveis na comunicação da ADR. Texto completo no portal do <a href="https://portal.cfm.org.br/" target="_blank" rel="noopener noreferrer">Conselho Federal de Medicina</a>.</p>
      </div>
      <ul class="checks col col--list sens" data-reveal>
        {d.sensiveis.map((s) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" /></svg>{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <div data-reveal style="margin-bottom:clamp(24px,2.8vw,36px)">
        <SectionLabel n="05" label="Dúvidas frequentes" />
        <h2 class="h2" id="faq-title">O que {d.plural} perguntam <span class="silver">antes de contratar</span></h2>
      </div>
      <Faq items={faq} />
      <p class="caption" style="margin-top:20px">Conteúdo produzido pela ADR Marketing (57.872.304 CAIO SOUZA ANDERLE, CNPJ 57.872.304/0001-66) com base na sua prática em marketing para a saúde. Não substitui orientação jurídica sobre publicidade médica nem garante resultado.</p>
    </div>
  </section>

  <section class="section section--tight section--line" aria-labelledby="an-title">
    <div class="container split an">
      <div class="col" data-reveal>
        <p class="kicker"><span class="kicker__line" aria-hidden="true"></span>Análise gratuita</p>
        <h2 class="h2" id="an-title">Análise de marketing para <span class="silver">{d.plural}</span></h2>
        <p class="lead">Conte o cenário da sua clínica e a ADR responde pelo WhatsApp em horário comercial com um diagnóstico comercial prévio — sem custo e sem compromisso.</p>
        <p class="small">Prefere ir direto? <a class="an__link" href={whatsappUrl(d.wa)} target="_blank" rel="noopener" data-wa={`${d.slug}-analise-link`}>Chamar no WhatsApp</a>.</p>
      </div>
      <div data-reveal><LeadForm origem={`especialidade_${d.slug}`} title={`Solicite uma análise para ${d.plural}`} /></div>
    </div>
  </section>

  <RelatedLinks title="Continue por aqui" links={[...related, { label: 'Serviços da ADR', href: '/servicos/', text: 'O que cada frente inclui e para quem é.' }, { label: 'Metodologia', href: '/metodologia/', text: 'Do diagnóstico ao paciente na cadeira.' }, { label: 'Como atrair pacientes particulares', href: '/blog/como-atrair-pacientes-particulares/', text: 'Artigo: de onde vem a demanda e o que a segura.' }, { label: 'Atendimento no WhatsApp para clínicas', href: '/blog/atendimento-whatsapp-para-clinicas/', text: 'Artigo: do contato ao agendamento.' }]} />
</BaseLayout>

<style>
  .col { flex: 1 1 380px; max-width: 560px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .col .kicker { margin: 0; }
  .col--list { max-width: none; flex: 1 1 360px; gap: 14px; }
  .col a, .lead a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .canais { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(14px, 1.7vw, 22px); }
  .canais .card { gap: 10px; }
  .canais .card__num { color: var(--muted-mid); letter-spacing: 0.18em; text-transform: uppercase; }
  .sens li { color: var(--muted-dark); }
  .sens svg { color: var(--text); }
  .an { align-items: flex-start; }
  .an__link { color: var(--ink); }
</style>
