---
import { RECADOS, whatsappUrl, DEFAULT_WA_MESSAGE } from '../data/site';

interface Props {
  waMessage?: string;
}
const { waMessage = DEFAULT_WA_MESSAGE } = Astro.props;
---

<div class="assist" data-assist data-recados={JSON.stringify(RECADOS)}>
  <div class="assist__bubble" data-assist-bubble hidden>
    <button type="button" class="assist__close" data-assist-close aria-label="Fechar mensagem">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <div class="assist__who">
      <img src="/assets/alanys.webp" alt="" width="160" height="160" loading="lazy" decoding="async" />
      <span>
        <strong>Atendimento · ADR Marketing</strong>
        <small><i aria-hidden="true"></i>Atendimento em horário comercial</small>
      </span>
    </div>
    <p class="assist__msg">
      <strong data-assist-title></strong>
      <span data-assist-text></span>
    </p>
    <div class="assist__actions">
      <a class="btn btn--wa btn--sm" href={whatsappUrl(waMessage)} target="_blank" rel="noopener" data-wa="assistente">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg>
        WhatsApp
      </a>
      <button type="button" class="btn btn--dark btn--sm" data-open-modal="assistente">Pedir análise</button>
    </div>
  </div>

  <button type="button" class="assist__btn" data-assist-open aria-label="Abrir mensagem do atendimento">
    <span class="assist__ping" aria-hidden="true"></span>
    <img src="/assets/alanys.webp" alt="" width="160" height="160" loading="lazy" decoding="async" />
    <span class="assist__wa" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg>
    </span>
  </button>
</div>

<style>
  .assist { position: fixed; right: clamp(14px, 2.2vw, 26px); bottom: clamp(14px, 2.2vw, 26px); z-index: 940; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; width: min(86vw, 316px); }
  .assist__bubble { position: relative; width: 100%; border-radius: 20px; background: var(--white); border: 1px solid rgba(31, 31, 30, 0.08); box-shadow: 0 28px 64px -18px rgba(0, 0, 0, 0.6); padding: 18px 18px 20px; color: var(--text); animation: bolhaIn 0.5s var(--ease) both; }
  /* Entrada só com movimento (sem opacidade): o texto mantém o contraste
     final desde o primeiro quadro. */
  @keyframes bolhaIn { from { transform: translate3d(0, 18px, 0) scale(0.97); } to { transform: none; } }
  .assist__bubble.is-out { opacity: 0; transform: translateY(10px); transition: opacity 0.35s, transform 0.35s; }
  .assist__close { position: absolute; top: 10px; right: 10px; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: var(--radius-pill); color: var(--n-400); transition: color 0.2s, background 0.2s; }
  .assist__close:hover { color: var(--text); background: rgba(31, 31, 30, 0.07); }
  .assist__who { display: flex; align-items: center; gap: 11px; margin-bottom: 12px; }
  .assist__who img { width: 40px; height: 40px; border-radius: var(--radius-pill); object-fit: cover; border: 1px solid rgba(31, 31, 30, 0.1); }
  .assist__who strong { display: block; font-weight: 600; font-size: 14px; color: #171716; }
  .assist__who small { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 500; color: var(--muted-dark); }
  .assist__who i { width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--text); display: block; }
  .assist__msg { display: block; margin-bottom: 14px; }
  .assist__msg strong { display: block; font-weight: 600; font-size: 14.5px; line-height: 1.3; color: #171716; margin-bottom: 5px; text-wrap: pretty; }
  .assist__msg span { display: block; font-size: 12.5px; line-height: 1.5; color: var(--text-2); text-wrap: pretty; }
  .assist__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .assist__btn { position: relative; flex: none; width: 66px; height: 66px; padding: 4px; border-radius: var(--radius-pill); background: var(--bg); border: 2px solid var(--n-300); box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7); transition: transform 0.25s var(--ease); }
  .assist__btn:hover { transform: translateY(-3px) scale(1.04); }
  .assist__btn img { width: 100%; height: 100%; border-radius: var(--radius-pill); object-fit: cover; }
  .assist__ping { position: absolute; inset: -4px; border: 1px solid rgba(242, 242, 243, 0.4); border-radius: var(--radius-pill); animation: ping 2.8s ease-out infinite; pointer-events: none; }
  .assist__wa { position: absolute; right: -2px; bottom: -2px; width: 22px; height: 22px; border-radius: var(--radius-pill); background: var(--wa); color: var(--wa-ink); border: 3px solid var(--bg); display: inline-flex; align-items: center; justify-content: center; }
</style>
