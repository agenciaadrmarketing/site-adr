  .ctrl__grid { position: absolute; inset: 0; pointer-events: none; opacity: 0.55; background-size: 58px 58px; background-image: linear-gradient(to right, rgba(242, 242, 243, 0.035) 1px, transparent 1px), linear-gradient(to bottom, rgba(242, 242, 243, 0.035) 1px, transparent 1px); mask-image: radial-gradient(ellipse at 45% 45%, #000 0%, transparent 74%); -webkit-mask-image: radial-gradient(ellipse at 45% 45%, #000 0%, transparent 74%); }
  .ctrl__content { position: relative; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: clamp(28px, 3.6vw, 56px); padding: clamp(28px, 4vw, 64px); min-height: clamp(480px, 52vw, 660px); }
  .ctrl__wordmark { position: absolute; z-index: 1; right: clamp(10px, 3%, 58px); top: 50%; transform: translateY(-50%); pointer-events: none; font-weight: 700; font-size: clamp(70px, 15.5vw, 228px); line-height: 0.78; letter-spacing: -0.05em; text-transform: uppercase; filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.75)); }
  .ctrl__text { position: relative; z-index: 5; flex: 1 1 300px; max-width: 460px; min-width: 0; }
