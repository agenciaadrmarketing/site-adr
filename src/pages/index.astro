<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; min-height: clamp(560px, 92svh, 1000px); display: flex; align-items: center; padding: clamp(44px, 6vw, 84px) var(--gutter) clamp(46px, 5vw, 70px); }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 72% center; opacity: 0.94; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, #09090a 0%, #09090a 30%, rgba(9, 9, 8, 0.94) 44%, rgba(9, 9, 8, 0.7) 58%, rgba(9, 9, 8, 0.3) 74%, rgba(9, 9, 8, 0.06) 100%); }
  .hero__fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9, 9, 8, 0.55) 0%, transparent 16%, transparent 76%, #09090a 100%); }
  .hero__in { position: relative; display: flex; flex-wrap: wrap; gap: clamp(36px, 4.5vw, 72px); align-items: flex-start; }
