  .phone__head small { display: block; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(242, 242, 243, 0.42); margin-bottom: 2px; }
  .phone__head b { display: block; font-size: 17px; font-weight: 600; color: var(--ink); }
