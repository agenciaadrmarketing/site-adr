  .phone__rows span { flex: 1 1 auto; height: 6px; border-radius: var(--radius-pill); background: rgba(242, 242, 243, 0.07); overflow: hidden; }
  .phone__rows i { display: block; height: 100%; border-radius: var(--radius-pill); background: linear-gradient(90deg, #d4d4d7, #f2f2f3); transform-origin: left; }
  .phone__ok { margin-top: auto; display: flex; align-items: center; gap: 11px; border-radius: 16px; padding: 12px; background: rgba(242, 242, 243, 0.06); border: 1px solid var(--line-2); }
  .phone__ok > span:first-child { flex: none; width: 30px; height: 30px; border-radius: var(--radius-pill); display: inline-flex; align-items: center; justify-content: center; background: rgba(242, 242, 243, 0.14); color: var(--ink); }
