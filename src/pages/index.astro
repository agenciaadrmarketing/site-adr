        <div class="qs__badge">
          <span class="qs__avatars">
            <img src="/assets/alanys.webp" alt="" width="160" height="160" loading="lazy" decoding="async" />
            <img src="/assets/caio.webp" alt="" width="900" height="1250" loading="lazy" decoding="async" />
            <span>ADR</span>
          </span>
