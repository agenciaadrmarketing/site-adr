  .ctrl__badge-ic--wa { background: rgba(37, 211, 102, 0.16); border-color: rgba(37, 211, 102, 0.35); color: var(--wa); }
  .phone { position: relative; z-index: 2; width: min(272px, 76vw); aspect-ratio: 272 / 556; border-radius: clamp(32px, 12vw, 46px); background: #0d0d0c; box-shadow: inset 0 0 0 2px #454544, inset 0 0 0 7px #050607, 0 44px 88px -18px rgba(0, 0, 0, 0.92); }
