  .hero__lead { font-size: clamp(15px, 1.25vw, 19px); line-height: 1.6; color: var(--ink-72); max-width: 54ch; text-wrap: pretty; }
  .hero__ctas { margin-top: 8px; }
  .hero__note { margin-top: 6px; font-size: 13.5px; color: var(--n-500); }
  .hero__down { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--n-500); }
  @media (max-width: 760px) {
    .hero__scrim { background: linear-gradient(178deg, rgba(9, 9, 8, 0.82) 0%, rgba(9, 9, 8, 0.72) 42%, rgba(9, 9, 8, 0.86) 74%, #09090a 100%); }
    .hero__img { object-position: 64% 12%; opacity: 0.5; }
    .hero__down { display: none; }
