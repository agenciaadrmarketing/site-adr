---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SpecialtyCard from '../components/SpecialtyCard.astro';
import MethodSteps from '../components/MethodSteps.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import { CONFIRMED_SERVICES, SPECIALTIES, FAQ, RECADOS } from '../data/site';
import { webPage, faqPage } from '../data/seo';

const title = 'Assessoria de Marketing Médico para Clínicas e Médicos | ADR Marketing';
const description =
  'Assessoria de marketing médico para clínicas e consultórios: posicionamento, autoridade digital e tráfego pago para captar pacientes particulares — do anúncio ao agendamento.';
const jsonLd = [webPage({ path: '/', title, description }), faqPage(FAQ, '/')];
const waHome = 'Olá! Vim pelo site da ADR e quero um diagnóstico de marketing para a minha clínica.';

const principios = [
  { title: 'Previsibilidade', description: 'Um ecossistema que substitui a dependência de indicações por demanda constante e mensurável.', icon: 'bars' as const },
  { title: 'Dentro das normas do setor', description: 'Estratégia construída sobre as regras da publicidade em saúde. Nada de "antes e depois".', icon: 'badge' as const },
];
const especialidades = [...SPECIALTIES].sort((a, b) => a.priority - b.priority);
const indicadores = [
  'Investimento em mídia por canal (Google Ads e Meta Ads)',
  'Contatos gerados e origem de cada um',
  'Pacientes qualificados na triagem',
  'Agendamentos confirmados pela recepção',
  'Custo por paciente qualificado e por agendamento',
];
const ribbon1 = ['Marketing para clínicas', 'Marketing médico', 'Tráfego pago', 'Captação de pacientes', 'Autoridade digital'];
const ribbon2 = ['Google Ads e Meta Ads', 'Pacientes particulares', 'Comercial de alta conversão', 'Previsibilidade', 'Modelo premium'];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} preloadHero="/assets/bg-hero.webp" waMessage={waHome}>
  <!-- 01 · HERO (preservado; copy refinada; CTA WhatsApp + formulário) -->
  <section id="home" class="hero" aria-labelledby="hero-title">
    <img class="hero__img" src="/assets/bg-hero.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__fade" aria-hidden="true"></div>
    <div class="container hero__in">
      <div class="hero__copy" data-reveal>
        <SectionLabel label="Assessoria premium · Medicina" class="hero__kicker" />
        <h1 class="h1" id="hero-title">Assessoria de Marketing para <span class="silver">Clínicas e Médicos</span></h1>
        <p class="hero__lead">Agência especializada em marketing médico. Estruturamos posicionamento, autoridade digital e tráfego pago para captar pacientes particulares — e preparamos o comercial da sua clínica para transformar contato em agendamento.</p>
        <div class="btn-row hero__ctas">
          <WhatsAppButton id="hero" label="Solicitar diagnóstico pelo WhatsApp" message={waHome} size="lg" arrow />
          <Button variant="outline" size="lg" openModal="hero-form">Pedir análise gratuita</Button>
        </div>
        <p class="hero__note">Vagas limitadas — o modelo admite um número restrito de parceiros simultâneos.</p>
      </div>
    </div>
    <a class="hero__down" href="#dores">
      Arraste para baixo
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" data-anim style="animation:bob 2.4s ease-in-out infinite"><path d="M12 5v14" /><path d="m5 12 7 7 7-7" /></svg>
    </a>
  </section>

  <!-- FITAS CRUZADAS (preservado) -->
  <div class="ribbons" data-anim-scope aria-hidden="true">
    <div class="ribbon"><div class="marquee">{[0, 1, 2, 3].map(() => <span>{ribbon1.map((t) => <><span>{t}</span><i>✦</i></>)}</span>)}</div></div>
    <div class="ribbon ribbon--front"><div class="marquee marquee--reverse">{[0, 1, 2, 3].map(() => <span>{ribbon2.map((t) => <><span>{t}</span><i>✦</i></>)}</span>)}</div></div>
  </div>

  <!-- 02 · CONTROLE NA MÃO (preservado; demonstração identificada; cores neutras) -->
  <section class="section ctrl" data-assist-trigger data-anim-scope aria-labelledby="ctrl-title">
    <div class="container ctrl__in">
      <div class="ctrl__card" data-reveal>
        <span class="ctrl__grid" aria-hidden="true"></span>
        <div class="ctrl__content">
          <p class="wordmark ctrl__wordmark" aria-hidden="true">ADR</p>
          <div class="ctrl__text">
            <h2 class="h2" id="ctrl-title">Tenha o controle <span class="silver">nas suas mãos</span></h2>
            <p class="lead">Resultados e relatórios da sua clínica direto no seu celular. Você acompanha o que foi investido, quantos pacientes qualificados chegaram e o que virou agendamento — sem depender de reunião para saber como a operação está.</p>
            <ul class="checks ctrl__list">
              {indicadores.map((i) => (
                <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{i}</li>
              ))}
            </ul>
            <Button variant="light" openModal="controle" arrow class="ctrl__btn">Quero acompanhar de perto</Button>
          </div>
          <div class="ctrl__stage">
            <div class="ctrl__badge ctrl__badge--a">
              <span class="ctrl__badge-ic ctrl__badge-ic--wa"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg></span>
              <span><strong>Relatório enviado</strong><small>Direto no WhatsApp</small></span>
            </div>
            <div class="ctrl__badge ctrl__badge--b">
              <span class="ctrl__badge-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
              <span><strong>Paciente qualificado</strong><small>Chegou pela campanha</small></span>
            </div>
            <div class="phone" role="img" aria-label="Simulação ilustrativa do relatório que a ADR envia pelo WhatsApp: pacientes qualificados, mídia, leads, agenda e consulta agendada">
              <div class="phone__screen">
                <span class="phone__shine" aria-hidden="true"></span>
                <div class="phone__notch" aria-hidden="true"><span></span></div>
                <div class="phone__ui" aria-hidden="true">
                  <div class="phone__head">
                    <span><small>Sua clínica</small><b>Relatório</b></span>
                    <span class="phone__adr">ADR</span>
                  </div>
                  <div class="phone__chart">
                    <small>Pacientes qualificados</small>
                    <div class="phone__bars">
                      {[38, 56, 44, 72, 60, 88, 76].map((h, i) => <span data-anim style={`height:${h}%; animation:barra ${3 + i * 0.4}s ease-in-out ${i * 0.2}s infinite`}></span>)}
                    </div>
                  </div>
                  <div class="phone__rows">
                    {[['Mídia', 86], ['Leads', 72], ['Agenda', 58]].map(([l, w], i) => (
                      <div><small>{l}</small><span><i data-anim style={`width:${w}%; animation:cresce 2.6s cubic-bezier(.16,1,.3,1) ${0.35 + i * 0.15}s both`}></i></span></div>
                    ))}
                  </div>
                  <div class="phone__ok">
                    <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg></span>
                    <span><b>Consulta agendada</b><small>Confirmada pela recepção</small></span>
                  </div>
                  <span class="phone__home"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="caption ctrl__caption">Simulação ilustrativa do formato do relatório. Os indicadores dependem do que a clínica registra; nenhum número aqui representa resultado de cliente.</p>
    </div>
  </section>

  <!-- 03 · DORES (novo; copy já existente nos recados da LP) -->
  <section id="dores" class="section section--light" aria-labelledby="dores-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="01" label="O que trava a agenda" />
          <h2 class="h2" id="dores-title">Reconhece algum desses <span class="graphite">sinais na sua clínica?</span></h2>
        </div>
        <p class="lead head-row__text">Quase nunca o problema é falta de pacientes na região. É falta de método: posicionamento fraco, filtro ruim na mídia e um comercial que não foi preparado para fechar.</p>
      </div>
      <ul class="dores">
        {RECADOS.map((r, i) => (
          <li class="dor" data-reveal>
            <span class="dor__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="dor__q">{r.titulo}</h3>
            <p class="dor__a">{r.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 04 · SERVIÇOS (preservado; só ofertas confirmadas + princípios) -->
  <section id="servicos" class="section" aria-labelledby="serv-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="02" label="O que fazemos" />
          <h2 class="h2" id="serv-title">Marketing médico para <span class="silver">clínicas e consultórios</span></h2>
        </div>
        <p class="lead head-row__text">Saúde não se vende como varejo. A decisão do paciente envolve confiança, reputação e uma jornada mais longa — e há normas éticas que limitam o que pode ser anunciado. Por isso a estratégia opera em frentes simultâneas e integradas.</p>
      </div>
      <div class="grid-cards serv-grid">
        {CONFIRMED_SERVICES.map((s, i) => (
          <ServiceCard service={{ ...s, href: '/servicos/' }} num={String(i + 1).padStart(2, '0')} tall={i === 0 || i === 2} large={i === 0 || i === 2} />
        ))}
        {principios.map((p, i) => (
          <ServiceCard service={p} num={String(CONFIRMED_SERVICES.length + i + 1).padStart(2, '0')} />
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · MATURAÇÃO (preservado; sem percentual, copy responsável) -->
  <section class="section section--light" aria-labelledby="mat-title">
    <div class="container split">
      <div class="mat__copy" data-reveal>
        <SectionLabel n="03" label="Previsibilidade" />
        <h2 class="h2" id="mat-title">A maturação tende a se estabilizar a partir do terceiro mês</h2>
        <p class="lead mat__lead">O mercado de saúde digital exige maturidade, não promessa de resultado imediato. Os dois primeiros meses estruturam posicionamento de autoridade e alinhamento comercial; é a partir daí que o fluxo de pacientes qualificados tende a se estabilizar.</p>
        <dl class="stats mat__stats">
          <div><dt>Mês 1 e 2</dt><dd>Estruturação</dd></div>
          <div><dt>Mês 3</dt><dd>Estabilidade</dd></div>
          <div><dt>Depois</dt><dd>Escala</dd></div>
        </dl>
        <p class="mat__disclaimer">O desempenho depende de fatores como especialidade, concorrência na região, investimento, posicionamento e qualidade do atendimento. A ADR acompanha os indicadores e otimiza continuamente as campanhas para melhorar o aproveitamento das oportunidades.</p>
        <Button variant="dark" openModal="maturacao" arrow>Quero esse cenário na minha clínica</Button>
      </div>
      <div class="mat__chart card card--white card--static" data-reveal>
        <div class="mat__legend">
          <p class="mat__chart-title">Curva de maturação</p>
          <div>
            <span><i class="mat__k mat__k--adr"></i>Com método</span>
            <span><i class="mat__k mat__k--sem"></i>Tráfego sem método</span>
          </div>
        </div>
        <svg viewBox="0 0 720 344" role="img" aria-label="Curva conceitual: com método, a operação tende a se estabilizar a partir do terceiro mês; tráfego sem método permanece baixo" class="mat__svg">
          <defs><linearGradient id="grad-adr" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1d1f20" stop-opacity="0.16" /><stop offset="100%" stop-color="#1d1f20" stop-opacity="0.01" /></linearGradient></defs>
          {[0, 25, 50, 75, 100].map((p) => { const y = 300 - p * 2.6; return (<><line x1="56" y1={y} x2="680" y2={y} stroke="rgba(31,31,30,0.12)" stroke-width="1" stroke-dasharray="4 4" /><text x="44" y={y + 4} text-anchor="end" font-size="11" fill="#5d5d60" font-family="Poppins, sans-serif">{p}%</text></>); })}
          <polygon points="56,253.2 181,175.2 306,66.0 431,55.6 556,50.4 680,45.2 680,300 56,300" fill="url(#grad-adr)" />
          <line x1="306" y1="40" x2="306" y2="300" stroke="#1d1f20" stroke-width="1" stroke-dasharray="5 5" opacity="0.4" />
          <polyline points="56,279.2 181,263.6 306,242.8 431,232.4 556,222.0 680,214.2" fill="none" stroke="#b7b7ba" stroke-width="2" stroke-dasharray="5 5" stroke-linecap="round" stroke-linejoin="round" />
          <polyline points="56,253.2 181,175.2 306,66.0 431,55.6 556,50.4 680,45.2" fill="none" stroke="#1d1f20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" data-anim style="stroke-dasharray:1400; animation:traca 2.4s cubic-bezier(.16,1,.3,1) .2s both" />
          {[[56, 253.2], [181, 175.2], [306, 66], [431, 55.6], [556, 50.4], [680, 45.2]].map(([x, y]) => <circle cx={x} cy={y} r="5" fill="#f2f2f3" stroke="#1d1f20" stroke-width="2" />)}
          <g><rect x="238" y="12" width="136" height="34" rx="17" fill="#1d1f20" /><text x="306" y="34" text-anchor="middle" font-size="13" font-weight="600" fill="#ffffff" font-family="Poppins, sans-serif">Estabilização</text></g>
          {['Mês 1', 'Mês 2', 'Mês 3', 'Mês 4', 'Mês 5', 'Mês 6'].map((m, i) => <text x={56 + i * 124.8} y="326" text-anchor="middle" font-size="11" fill="#5d5d60" font-family="Poppins, sans-serif">{m}</text>)}
        </svg>
        <p class="caption">Curva conceitual e ilustrativa do comportamento esperado de uma operação com método. Não representa resultado de cliente; a maturação varia conforme a competitividade da região e o ticket médio dos tratamentos.</p>
      </div>
    </div>
  </section>

  <!-- 06 · PRESENÇA DIGITAL (melhorado: sinais acompanhados, sem percentuais) -->
  <section class="section section--line presenca" data-anim-scope aria-labelledby="pres-title">
    <span class="presenca__glow presenca__glow--a" aria-hidden="true" data-anim></span>
    <span class="presenca__glow presenca__glow--b" aria-hidden="true" data-anim></span>
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="04" label="Presença digital" />
          <h2 class="h2 h2--xl" id="pres-title">Autoridade não se mede em curtida. <span class="silver">Se mede em agenda.</span></h2>
        </div>
        <p class="lead head-row__text">Seguidor e engajamento são consequência de um posicionamento bem construído — e sinal de que o paciente já confia em você antes da primeira consulta. Acompanhamos os três sinais abaixo junto com os indicadores comerciais, nunca isolados.</p>
      </div>
      <div class="grid-cards presenca__grid">
        <article class="card card--glass sinal" data-luz data-reveal>
          <span class="card-luz" aria-hidden="true"></span>
          <div class="sinal__top"><span class="sinal__k"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Seguidores</span><span class="sinal__tag">Sinal acompanhado</span></div>
          <div class="sinal__viz"><svg viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="sg1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#d4d4d7" stop-opacity="0.28" /><stop offset="100%" stop-color="#d4d4d7" stop-opacity="0.02" /></linearGradient></defs><polygon points="0,170 75,159.8 150,146.1 225,137.6 300,115.4 375,101.7 450,74.4 525,55.6 600,30 600,180 0,180" fill="url(#sg1)" /><polyline points="0,170 75,159.8 150,146.1 225,137.6 300,115.4 375,101.7 450,74.4 525,55.6 600,30" fill="none" stroke="#d4d4d7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" /></svg></div>
          <div><h3 class="sinal__title">Crescimento de audiência qualificada</h3><p class="card__text">Público da sua região e do seu perfil de procedimento — não seguidor de fora que nunca vai agendar.</p></div>
        </article>
        <article class="card card--glass sinal" data-luz data-reveal>
          <span class="card-luz" aria-hidden="true"></span>
          <div class="sinal__top"><span class="sinal__k"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>Engajamento</span><span class="sinal__tag">Sinal acompanhado</span></div>
          <div class="sinal__viz sinal__bars" aria-hidden="true">{[28, 41, 36, 55, 62, 58, 74, 81, 96].map((h, i) => <span data-anim style={`height:${h}%; animation:barra ${2.8 + i * 0.3}s ease-in-out ${i * 0.14}s infinite`}></span>)}</div>
          <div><h3 class="sinal__title">Conversa que vira consulta</h3><p class="card__text">Comentário e direct são o primeiro contato comercial. Medimos o que abre conversa, não o que junta aplauso.</p></div>
        </article>
        <article class="card card--glass sinal" data-luz data-reveal>
          <span class="card-luz" aria-hidden="true"></span>
          <div class="sinal__top"><span class="sinal__k"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>Alcance</span><span class="sinal__tag">Sinal acompanhado</span></div>
          <div class="sinal__viz sinal__ring" aria-hidden="true">
            <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="48" fill="none" stroke="rgba(242,242,243,0.08)" stroke-width="11" /><circle cx="60" cy="60" r="48" fill="none" stroke="#d4d4d7" stroke-width="11" stroke-linecap="round" stroke-dasharray="301.6" stroke-dashoffset="60" data-anim style="animation:anel 2.4s cubic-bezier(.16,1,.3,1) .3s both" /></svg>
            <p>Alcance além da própria base</p>
          </div>
          <div><h3 class="sinal__title">Presença além dos seguidores</h3><p class="card__text">Quantas vezes o conteúdo alcança gente nova em relação ao tamanho do seu perfil.</p></div>
        </article>
      </div>
      <div class="presenca__foot" data-reveal>
        <p>Quer ver esses três sinais acompanhados junto com a agenda da sua clínica?</p>
        <WhatsAppButton id="presenca" label="Conversar com um especialista" message={waHome} arrow />
      </div>
    </div>
  </section>

  <!-- 07 · ESPECIALIDADES (novo) -->
  <section id="especialidades" class="section section--light" aria-labelledby="esp-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="05" label="Especialidades" />
          <h2 class="h2" id="esp-title">Marketing médico <span class="graphite">por especialidade</span></h2>
        </div>
        <p class="lead head-row__text">Cada especialidade tem jornada, ticket e concorrência próprios. As especialidades com link já têm página dedicada; para as demais, o caminho é o diagnóstico direto com a ADR.</p>
      </div>
      <ul class="esp-grid">
        {especialidades.map((s) => (<li><SpecialtyCard specialty={s} /></li>))}
      </ul>
    </div>
  </section>

  <!-- 08 · PILARES (preservado) -->
  <section class="section" aria-labelledby="pil-title">
    <div class="container">
      <div data-reveal style="margin-bottom:clamp(32px,4vw,60px)">
        <SectionLabel n="06" label="O ecossistema de previsibilidade" />
        <h2 class="h2" id="pil-title">Estratégias para <span class="silver">atrair pacientes particulares</span></h2>
      </div>
      <div class="pilares">
        <article class="pilar" data-reveal>
          <div>
            <p class="pilar__k">Pilar 01 · Previsibilidade</p>
            <h3 class="pilar__t">Não adianta ser um <span class="silver">excelente médico</span> e depender apenas de indicações ou lutar por preço.</h3>
            <p class="lead">Nossa assessoria blinda sua autoridade e constrói uma presença digital sofisticada para atrair o paciente ideal. Transformamos seu consultório em um ativo previsível, para você focar apenas na medicina.</p>
          </div>
          <img src="/assets/pilar-1.webp" alt="Gráfico comparando o reconhecimento e a escalabilidade de uma clínica com marketing estruturado" width="811" height="702" loading="lazy" decoding="async" />
        </article>
        <article class="pilar" data-reveal>
          <div>
            <p class="pilar__k">Pilar 02 · Autoridade</p>
            <h3 class="pilar__t">Destaque-se como <span class="silver">a autoridade em sua região.</span></h3>
            <p class="lead">Elevamos sua percepção de valor para que o paciente escolha você pela especialidade, não pelo preço. Construímos o reconhecimento necessário para que sua consulta seja o desejo do público ideal antes mesmo do primeiro contato.</p>
          </div>
          <img src="/assets/pilar-3.webp" alt="Pódio ilustrando o profissional posicionado como autoridade na sua região" width="811" height="702" loading="lazy" decoding="async" />
        </article>
        <article class="pilar" data-reveal>
          <div>
            <p class="pilar__k">Pilar 03 · Demanda</p>
            <h3 class="pilar__t">Gere um fluxo constante de <span class="silver">pacientes qualificados.</span></h3>
            <p class="lead">Através de inteligência em tráfego pago, estruturamos demanda contínua para sua clínica. Não buscamos apenas volume; filtramos o público para atrair apenas pacientes com o perfil ideal, otimizando seu investimento e o tempo da sua equipe.</p>
          </div>
          <img src="/assets/pilar-4.webp" alt="Mensagens recusadas de um lado e agendamentos confirmados do outro, ilustrando a filtragem de pacientes" width="811" height="702" loading="lazy" decoding="async" />
        </article>
