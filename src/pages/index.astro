  .ctrl__badge { position: absolute; z-index: 6; display: flex; align-items: center; gap: 11px; padding: 11px 15px; border-radius: 16px; background: linear-gradient(135deg, rgba(51, 51, 50, 0.96), rgba(24, 24, 23, 0.94)); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 28px 56px -14px rgba(0, 0, 0, 0.85); }
