---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SpecialtyCard from '../components/SpecialtyCard.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SPECIALTIES } from '../data/site';
import { webPage, breadcrumbList, faqPage } from '../data/seo';

const title = 'Marketing médico: como atrair pacientes particulares | ADR Marketing';
const description =
  'O que é marketing médico, o que a Resolução CFM nº 2.336/2023 permite, Google Ads × Meta Ads e como escolher uma agência especializada. Guia da ADR Marketing.';
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Marketing médico', href: '/marketing-medico/' }];
const wa = 'Olá! Li o guia de marketing médico da ADR e quero conversar sobre a minha clínica.';
const especialidades = [...SPECIALTIES].sort((a, b) => a.priority - b.priority);

const faq = [
  { tag: 'Captação', q: 'Qual a melhor forma de atrair pacientes particulares?', a: 'Combinando três frentes: um posicionamento claro (por que escolher você, e não o convênio ou o concorrente), demanda qualificada (Google Ads para quem já procura o tratamento e Meta Ads para quem ainda vai desejá-lo) e um atendimento preparado para converter o contato em agendamento. Indicação continua importante, mas não é previsível nem escalável sozinha.' },
  { tag: 'Contratação', q: 'Como escolher uma agência de marketing médico?', a: 'Avalie quem vai operar a conta de fato (liderança sênior ou gestor júnior), se a agência conhece as regras de publicidade médica, se mede agendamentos — e não só cliques —, se integra marketing e comercial, e se começa por um diagnóstico em vez de uma proposta pronta. Desconfie de garantias de resultado, prazo ou volume de pacientes.' },
  { tag: 'Investimento', q: 'Quanto custa contratar marketing para uma clínica?', a: 'Depende de três variáveis: a verba de mídia paga às plataformas (Google e Meta), o escopo do serviço e o estágio da clínica (posicionamento, comercial, região). A ADR não publica tabela de preços; o investimento é definido após o diagnóstico comercial prévio, com a verba de mídia tratada separadamente dos honorários.' },
  { tag: 'Canais', q: 'Vale a pena investir em Google Ads para consultório médico?', a: 'Quando existe demanda ativa pelo tratamento na sua região e a clínica consegue atender bem esse contato, sim: o Google Ads captura quem já está procurando. O risco está em campanhas genéricas, sem filtro de público e sem acompanhamento do que virou consulta — é isso que transforma mídia em custo.' },
  { tag: 'Canais', q: 'Qual a diferença entre tráfego pago e SEO médico?', a: 'Tráfego pago (Google Ads e Meta Ads) compra visibilidade imediata e controlável, mas para quando o investimento para. SEO constrói presença orgânica em buscas, com resultado mais lento e cumulativo. As duas frentes se complementam; a ADR atua com tráfego pago e posicionamento, e trata SEO como tema educativo nesta página.' },
  { tag: 'Comercial', q: 'Como aumentar os agendamentos de uma clínica?', a: 'Normalmente o gargalo não está na quantidade de contatos, e sim no que acontece depois: tempo de resposta no WhatsApp, triagem do curioso versus paciente com intenção, follow-up de quem não respondeu e registro do agendamento como métrica. Ajustar esse funil costuma render mais do que aumentar a verba.' },
  { tag: 'Contratação', q: 'O que avaliar antes de contratar uma agência de marketing médico?', a: 'Quatro pontos: conformidade com a publicidade médica, quem opera a conta, quais indicadores serão reportados e com que frequência, e se há um diagnóstico antes da proposta. Peça também para entender como a agência separa verba de mídia de honorários.' },
];
const jsonLd = [webPage({ path: '/marketing-medico/', title, description }), breadcrumbList(crumbs), faqPage(faq, '/marketing-medico/')];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} waMessage={wa} cta={{ waMessage: wa, id: 'cta-mm' }}>
  <PageHero
    kicker="Guia · Marketing médico"
    title="Marketing médico: como clínicas e médicos"
    titleAccent="atraem pacientes particulares"
    text="Marketing médico é o conjunto de estratégias de posicionamento, comunicação e mídia que um médico ou clínica usa para ser encontrado, escolhido e agendado por pacientes — dentro das regras de publicidade do Conselho Federal de Medicina. Na prática, envolve três frentes: autoridade (ser lembrado), demanda (ser encontrado) e conversão (ser agendado)."
    crumbs={crumbs}
    variant="service"
  >
    <WhatsAppButton id="mm-hero" label="Conversar com um especialista" message={wa} arrow />
    <Button variant="outline" openModal="mm-hero">Pedir análise gratuita</Button>
  </PageHero>

  <section class="section" aria-labelledby="dif-title">
    <div class="container split">
      <div style="flex:1 1 380px; max-width:560px" data-reveal>
        <SectionLabel n="01" label="O que muda na saúde" />
        <h2 class="h2" id="dif-title">Saúde não se vende <span class="silver">como varejo</span></h2>
        <p class="lead" style="margin-top:16px">A decisão do paciente envolve confiança, reputação e uma jornada mais longa do que a de um produto. E há normas éticas que limitam o que pode ser anunciado. Por isso a estratégia precisa operar em frentes simultâneas, e não em uma campanha isolada.</p>
      </div>
      <ul class="tres" data-reveal>
        <li class="card card--static"><span class="card__num">01</span><h3 class="h3">Autoridade — ser lembrado</h3><p class="card__text">Posicionamento e presença digital que sustentam a percepção de valor antes da consulta. É o que faz o paciente escolher pela especialidade, não pelo preço.</p></li>
        <li class="card card--static"><span class="card__num">02</span><h3 class="h3">Demanda — ser encontrado</h3><p class="card__text">Google Ads captura quem já procura o tratamento; Meta Ads constrói desejo e confiança em quem ainda vai procurar. O filtro de público decide a qualidade do contato.</p></li>
        <li class="card card--static"><span class="card__num">03</span><h3 class="h3">Conversão — ser agendado</h3><p class="card__text">Atendimento no WhatsApp, triagem, recepção ou SDR e follow-up. O fechamento acontece dentro da clínica, e é ali que a maioria das oportunidades se perde.</p></li>
      </ul>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="cmp-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="02" label="Comparação" />
          <h2 class="h2" id="cmp-title">Google Ads ou Meta Ads <span class="graphite">para médicos?</span></h2>
        </div>
        <p class="lead head-row__text">Não são concorrentes: atuam em momentos diferentes da jornada do paciente. A escolha depende da especialidade, do procedimento e de quanta demanda ativa já existe na região.</p>
      </div>
      <div class="tbl" data-reveal>
        <table>
          <thead><tr><th scope="col">Critério</th><th scope="col">Google Ads</th><th scope="col">Meta Ads (Instagram e Facebook)</th></tr></thead>
          <tbody>
            <tr><th scope="row">Momento da jornada</th><td>Paciente já procura o tratamento ou a especialidade</td><td>Paciente ainda não decidiu; o desejo é construído</td></tr>
            <tr><th scope="row">Tipo de demanda</th><td>Captura demanda existente</td><td>Cria demanda e reforça autoridade</td></tr>
            <tr><th scope="row">Melhor para</th><td>Procedimentos e consultas com busca ativa na região</td><td>Posicionamento, procedimentos eletivos e relacionamento</td></tr>
            <tr><th scope="row">Risco comum</th><td>Palavras genéricas e cliques sem filtro de público</td><td>Alcance alto com contatos pouco qualificados</td></tr>
            <tr><th scope="row">Como a ADR usa</th><td>Capturar quem já busca, com filtro por ticket e região</td><td>Construir confiança antes do primeiro contato</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="norma-title">
    <div class="container split">
      <div style="flex:1 1 380px; max-width:560px" data-reveal>
        <SectionLabel n="03" label="Publicidade médica" />
        <h2 class="h2" id="norma-title">O que a norma <span class="silver">permite e veda</span></h2>
        <p class="lead" style="margin-top:16px">A Resolução CFM nº 2.336/2023 atualizou as regras de publicidade e propaganda médica no Brasil. Ela ampliou o que pode ser divulgado — como a especialidade registrada e informações de serviço — e manteve vedados o sensacionalismo, a promessa de resultado e a concorrência desleal. Consulte o texto completo no portal do <a href="https://portal.cfm.org.br/" target="_blank" rel="noopener noreferrer">Conselho Federal de Medicina</a>.</p>
        <p class="lead" style="margin-top:14px">A ADR adota uma linha mais conservadora do que a norma exige: não usa "antes e depois" nas campanhas e não trabalha com garantias de resultado, prazo ou volume de pacientes.</p>
      </div>
      <ul class="checks norma" data-reveal>
        {['Divulgar especialidade e títulos registrados no conselho', 'Comunicar serviços, horários e canais de atendimento', 'Produzir conteúdo educativo com responsabilidade técnica', 'Anunciar com segmentação por região e interesse'].map((t) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{t}</li>
        ))}
        {['Prometer ou garantir resultado de tratamento', 'Sensacionalismo e autopromoção exagerada', 'Depoimentos de pacientes com fim publicitário', 'Concorrência desleal e comparação com colegas'].map((t) => (
          <li class="norma__no"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" /></svg>{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="especialidades" class="section section--light" aria-labelledby="esp-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="04" label="Especialidades" />
          <h2 class="h2" id="esp-title">Marketing por <span class="graphite">especialidade médica</span></h2>
        </div>
        <p class="lead head-row__text">Jornada, ticket e concorrência mudam de uma especialidade para outra. As especialidades com link já têm página dedicada.</p>
      </div>
      <ul class="esp-grid">{especialidades.map((s) => (<li><SpecialtyCard specialty={s} /></li>))}</ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-mm-title">
    <div class="container container--narrow">
      <div data-reveal style="margin-bottom:clamp(24px,2.8vw,36px)">
        <SectionLabel n="05" label="Dúvidas frequentes" />
        <h2 class="h2" id="faq-mm-title">O que médicos perguntam antes de <span class="silver">investir em marketing</span></h2>
      </div>
      <Faq items={faq} />
      <p class="caption" style="margin-top:20px">Conteúdo produzido pela ADR Marketing ({'57.872.304 CAIO SOUZA ANDERLE'}, CNPJ 57.872.304/0001-66) com base na sua prática em marketing para a saúde. Não substitui orientação jurídica sobre publicidade médica.</p>
    </div>
  </section>

  <RelatedLinks
    links={[
      { label: 'Serviços da ADR', href: '/servicos/', text: 'Tráfego pago, posicionamento, captação e comercial.' },
      { label: 'Metodologia', href: '/metodologia/', text: 'Do diagnóstico ao paciente na cadeira.' },
      { label: 'Como atrair pacientes particulares', href: '/blog/como-atrair-pacientes-particulares/', text: 'Artigo: os três caminhos que se reforçam.' },
      { label: 'Google Ads ou Meta Ads para médicos?', href: '/blog/google-ads-ou-meta-ads-para-medicos/', text: 'Artigo: comparação por intenção e especialidade.' },
      { label: 'Autoridade digital para médicos', href: '/blog/autoridade-digital-para-medicos/', text: 'Artigo: presença e reconhecimento dentro das normas.' },
      { label: 'SEO local para clínicas', href: '/blog/seo-local-para-clinicas/', text: 'Artigo: o básico para aparecer nas buscas locais.' },
      { label: 'Sobre a ADR', href: '/sobre/', text: 'Quem conduz e como trabalhamos.' },
      { label: 'Contato', href: '/contato/', text: 'Solicite um diagnóstico comercial prévio.' },
    ]}
  />
</BaseLayout>

<style>
  .tres { flex: 1 1 420px; display: grid; gap: 14px; }
  .tres .card { gap: 8px; }
  .tbl { overflow-x: auto; border: 1px solid var(--line-light); border-radius: var(--radius-card); background: var(--white); box-shadow: var(--shadow-white); }
  table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 640px; }
  th, td { text-align: left; padding: 16px 18px; border-bottom: 1px solid var(--line-light-2); vertical-align: top; color: var(--text-2); }
  thead th { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-dark); background: var(--paper); }
  tbody th { font-weight: 600; color: var(--text); width: 22%; }
  tbody tr:last-child td, tbody tr:last-child th { border-bottom: 0; }
  .norma { flex: 1 1 360px; gap: 12px; }
  .norma li { color: var(--ink-72); }
  .norma__no { color: var(--n-500) !important; }
  .norma__no svg { color: var(--n-500); }
  .esp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 12px; }
  .esp-grid :global(.spec) { background: var(--white); border-color: var(--line-light-2); color: var(--text); box-shadow: var(--shadow-white); }
  .esp-grid :global(.spec__for) { color: var(--muted-dark); }
  .esp-grid :global(.spec__go) { border-color: var(--line-light); color: var(--text); }
  .esp-grid :global(.spec__go--soon) { color: var(--n-400); }
  .lead a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
