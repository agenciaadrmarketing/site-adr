---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MethodSteps from '../components/MethodSteps.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { webPage, breadcrumbList } from '../data/seo';

const title = 'Metodologia ADR: do diagnóstico ao paciente na cadeira';
const description =
  'As quatro etapas da metodologia ADR: diagnóstico comercial, posicionamento de autoridade, tráfego pago (Google e Meta Ads) e comercial de alta conversão.';
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Metodologia', href: '/metodologia/' }];
const jsonLd = [webPage({ path: '/metodologia/', title, description }), breadcrumbList(crumbs)];
const wa = 'Olá! Vi a metodologia da ADR e quero saber se faz sentido para a minha clínica.';

const etapas = [
  { k: 'Etapa 01', t: 'Diagnóstico comercial prévio', d: 'Antes de qualquer proposta, avaliamos o cenário da clínica: presença digital, ticket dos procedimentos, competitividade da região e maturidade do comercial. É esse diagnóstico que define se a parceria faz sentido — e qual frente começa primeiro.', o: ['Leitura da presença digital atual', 'Ticket e margem dos procedimentos', 'Concorrência e demanda na região', 'Como a clínica atende hoje'] },
  { k: 'Etapa 02', t: 'Posicionamento de autoridade', d: 'Construímos a presença digital que blinda a reputação do profissional e eleva a percepção de valor — dentro das normas éticas do setor. O paciente passa a desejar a sua consulta antes do primeiro contato.', o: ['Posicionamento por especialidade e região', 'Linha de comunicação conforme o CFM', 'Coerência entre anúncio e atendimento'] },
  { k: 'Etapa 03', t: 'Tráfego pago em Google Ads e Meta Ads', d: 'Campanhas operadas pela liderança sênior, com filtragem de público para atrair apenas o perfil de alto valor. Google Ads captura a demanda existente; Meta Ads constrói a que ainda não existe.', o: ['Estrutura de campanhas por intenção', 'Filtro de público por ticket e região', 'Otimização contínua por indicador comercial'] },
  { k: 'Etapa 04', t: 'Comercial de alta conversão', d: 'O fechamento acontece dentro da clínica. Atuamos de forma consultiva na estruturação do setor comercial, com treinamento de qualificação para a recepção ou orientação para implementar SDRs de alta performance.', o: ['Atendimento no WhatsApp padronizado', 'Triagem e qualificação', 'Follow-up com cadência definida'] },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} waMessage={wa} cta={{ waMessage: wa, id: 'cta-metodologia' }}>
  <PageHero
    kicker="Metodologia"
    title="Do diagnóstico ao"
    titleAccent="paciente na cadeira"
    text="Um método em etapas — diagnóstico, posicionamento, campanhas e atendimento —, acompanhado mês a mês até o paciente chegar à consulta."
    crumbs={crumbs}
    variant="service"
  >
    <WhatsAppButton id="met-hero" label="Solicitar diagnóstico pelo WhatsApp" message={wa} arrow />
    <Button variant="outline" openModal="met-hero">Pedir diagnóstico da agenda</Button>
  </PageHero>

  <section class="section section--light" aria-labelledby="et-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="head-row__title">
          <SectionLabel n="01" label="As quatro etapas" />
          <h2 class="h2" id="et-title">Como a parceria <span class="graphite">funciona</span></h2>
        </div>
        <p class="lead head-row__text">O modelo admite um número restrito de parceiros simultâneos. Nada aqui roda em escala: cada etapa é conduzida pela liderança sênior.</p>
      </div>
      <ol class="etapas">
        {etapas.map((e) => (
          <li class="card card--white card--static etapa" data-reveal>
            <p class="etapa__k">{e.k}</p>
            <h3 class="h3">{e.t}</h3>
            <p class="card__text">{e.d}</p>
            <ul class="checks etapa__list">{e.o.map((o) => (<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{o}</li>))}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="com-title">
    <div class="container">
      <div data-reveal style="max-width:760px; margin-bottom:clamp(8px,1.5vw,20px)">
        <SectionLabel n="02" label="Dentro da clínica" />
        <h2 class="h2" id="com-title">O pilar comercial, <span class="silver">passo a passo</span></h2>
        <p class="lead" style="margin-top:16px">Marketing sozinho não fecha tratamento. A inteligência de tráfego gera e filtra a demanda, mas o fechamento acontece dentro da clínica — por isso a metodologia integra um pilar dedicado ao comercial.</p>
      </div>
      <MethodSteps />
    </div>
  </section>

  <section class="section section--light" aria-labelledby="ac-title">
    <div class="container split">
      <div style="flex:1 1 380px; max-width:560px" data-reveal>
        <SectionLabel n="03" label="Acompanhamento" />
        <h2 class="h2" id="ac-title">Indicadores de agenda, <span class="graphite">não de clique</span></h2>
        <p class="lead" style="margin-top:16px">Relatórios enviados pelo WhatsApp da clínica, com o que foi investido, quantos contatos chegaram, quantos foram qualificados e o que virou agendamento. Os indicadores dependem do que a clínica consegue registrar — e nenhum número é promessa.</p>
        <p class="lead" style="margin-top:14px">O desempenho das estratégias depende de fatores como especialidade, concorrência, investimento, posicionamento e qualidade do atendimento. A maturação tende a se estabilizar a partir do terceiro mês, variando conforme a região e o ticket dos tratamentos.</p>
      </div>
      <ul class="checks ind" data-reveal>
        {['Investimento em mídia por canal', 'Contatos gerados e origem', 'Pacientes qualificados na triagem', 'Agendamentos confirmados pela recepção', 'Custo por paciente qualificado e por agendamento', 'Ajustes feitos no mês e próximos passos'].map((t) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <RelatedLinks
    links={[
      { label: 'Serviços', href: '/servicos/', text: 'O que cada frente inclui e para quem é.' },
      { label: 'Marketing médico', href: '/marketing-medico/', text: 'Guia: o que a norma permite, Google Ads × Meta Ads.' },
      { label: 'Por que clínicas perdem agendamentos', href: '/blog/por-que-clinicas-perdem-agendamentos/', text: 'Artigo: onde o contato se perde depois do clique.' },
      { label: 'Atendimento no WhatsApp para clínicas', href: '/blog/atendimento-whatsapp-para-clinicas/', text: 'Artigo: boas práticas do primeiro contato.' },
      { label: 'Indicadores de marketing para clínicas', href: '/blog/indicadores-de-marketing-para-clinicas/', text: 'Artigo: o que acompanhar em cada camada.' },
      { label: 'Sobre a ADR', href: '/sobre/', text: 'Quem conduz e os compromissos do modelo.' },
      { label: 'Contato', href: '/contato/', text: 'Comece pelo diagnóstico comercial prévio.' },
    ]}
  />
</BaseLayout>

<style>
  .etapas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: clamp(14px, 1.7vw, 22px); }
  .etapa { gap: 10px; }
  .etapa__k { font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted-dark); }
  .etapa__list { margin-top: 8px; gap: 8px; }
  .etapa__list li { font-size: 14px; }
  .ind { flex: 1 1 360px; }
</style>
