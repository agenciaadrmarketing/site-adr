---
// Página com todos os cases. Só é gerada quando existe ao menos um case
// publicável (regra: /cases/ não existe sem conteúdo verificável).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { webPage, breadcrumbList } from '../../data/seo';
import { SITE } from '../../data/site';
import { casesVisiveis } from '../../lib/cases';

export async function getStaticPaths() {
  const lista = await casesVisiveis();
  return lista.length ? [{ params: { hub: undefined }, props: { lista } }] : [];
}

const { lista } = Astro.props;
const algumPublico = lista.some((c) => c.publicavel);
const title = 'Cases de marketing médico: a evolução de cada cliente | ADR';
const description = 'Cases reais da ADR Marketing com médicos: ponto de partida, o que foi feito mês a mês e os números de antes e depois, com a origem de cada dado.';
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Cases', href: '/cases/' }];
const itemList = {
  '@type': 'ItemList',
  '@id': `${SITE.url}/cases/#lista`,
  itemListElement: lista.filter((c) => c.publicavel).map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/cases/${c.data.slug}/`, name: c.data.h1 })),
};
const jsonLd = [webPage({ path: '/cases/', title, description, type: 'CollectionPage' }), breadcrumbList(crumbs), itemList];
const wa = 'Olá! Vi os cases da ADR e quero entender como seria no meu consultório.';
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={!algumPublico} waMessage={wa} cta={{ waMessage: wa, id: 'cta-cases' }}>
  <PageHero
    kicker="Cases"
    title="Médicos que já trabalham com a ADR"
    titleAccent="e o que mudou na agenda"
    text="Cada case mostra o ponto de partida, o que foi feito mês a mês e os números de antes e depois, com a origem de cada dado. Resultados dependem da especialidade, da concorrência, do investimento e do atendimento."
    crumbs={crumbs}
  >
    <WhatsAppButton id="cases-hero" label="Falar com a ADR" message={wa} arrow />
  </PageHero>

  <section class="section" aria-label="Lista de cases">
    <div class="container cases-grid">
      {lista.map((c) => (
        <a class="card case-card" href={`/cases/${c.data.slug}/`} data-reveal>
          {c.data.video && (
            <img class="case-card__thumb" src={`https://i.ytimg.com/vi/${c.data.video.youtubeId}/hqdefault.jpg`} alt={`Depoimento em vídeo: ${c.data.medico}`} width="480" height="360" loading="lazy" decoding="async" />
          )}
          <p class="kicker"><span class="kicker__line" aria-hidden="true"></span>{c.data.especialidade} · {c.data.cidade}/{c.data.uf}</p>
          <h2 class="h3">{c.data.medico}</h2>
          <p class="card__text">{c.data.resumo}</p>
          <dl class="case-card__num">
            <dt>{c.data.destaque.label}</dt>
            <dd><span>{c.data.destaque.antes}</span> → <strong>{c.data.destaque.depois}</strong></dd>
          </dl>
          <p class="small">{c.data.periodo}</p>
          <span class="case-card__link">Ver a evolução →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .cases-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .case-card { gap: 12px; color: inherit; text-decoration: none; }
  .case-card__thumb { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; }
  .case-card__num { border-top: 1px solid var(--line-2); padding-top: 12px; }
  .case-card__num dt { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--n-500); }
  .case-card__num dd { font-size: 20px; margin-top: 4px; }
  .case-card__num dd span { color: var(--n-500); }
  .case-card__link { font-weight: 600; font-size: 14px; margin-top: auto; }
</style>
